rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Planner ciphertext, wrapped DEKs, vectors, proposals, chats, and audit events
    // are server-only. Firebase Admin/Cloud Run bypasses client security rules and
    // performs verified-UID authorization in FastAPI.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
