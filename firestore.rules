rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Planner ciphertext, wrapped DEKs, vectors, proposals, chats, and audit events
    // are server-only. Firebase Admin/Cloud Run bypasses client security rules and
    // performs verified-UID authorization in FastAPI.
    match /{document=**} {
      allow read, write: if false;
    }

    // The one exception: a content-free change marker ({version, updated_at})
    // the backend bumps on every record write. A signed-in device may read its
    // own so it can listen for changes made elsewhere and refetch through the
    // API. Rules are OR-ed across matches, so this grants nothing else.
    match /users/{uid}/meta/sync {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
  }
}
