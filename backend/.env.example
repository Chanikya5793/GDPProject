PLANNER_ENVIRONMENT=development
PLANNER_GOOGLE_CLOUD_PROJECT=replace-me
PLANNER_FIREBASE_PROJECT_ID=replace-me
PLANNER_KMS_KEY_NAME=projects/replace-me/locations/us/keyRings/planner/cryptoKeys/user-data
PLANNER_FIRESTORE_DATABASE=(default)
PLANNER_MUSE_BASE_URL=https://api.meta.ai/v1
PLANNER_MUSE_MODEL=muse-spark-1.3-contributor
# Secret Manager resource holding the Muse API key. Must pin an explicit version.
# Never put the key itself in this file.
PLANNER_MUSE_API_KEY_RESOURCE=projects/replace-me/secrets/muse-api-key/versions/1
PLANNER_MUSE_REASONING_EFFORT=xhigh
PLANNER_MUSE_TIMEOUT_SECONDS=120
PLANNER_ALLOWED_ORIGINS=["http://localhost:5173"]
PLANNER_MCP_SESSION_SECRET_RESOURCE=projects/replace-me/secrets/planner-mcp-session/versions/1
PLANNER_RETRIEVAL_LIMIT=5
PLANNER_MAX_DAILY_MINUTES=360
PLANNER_CHAT_RATE_LIMIT_REQUESTS=20
PLANNER_CHAT_RATE_LIMIT_WINDOW_SECONDS=3600
