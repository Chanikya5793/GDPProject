{
  "expo": {
    "name": "NW Student Planner",
    "slug": "nw-student-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nwplanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nwmissouri.studentplanner",
      "buildNumber": "3",
      "infoPlist": {
        "CFBundleDisplayName": "NW Planner",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "YDF2TB9967"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.nwmissouri.studentplanner",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/withUISceneLifecycle",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach images from your photo library to a note. Attachments stay encrypted on this device.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withoutPushEntitlement",
      "./plugins/withSiriShortcuts",
      "./plugins/withAndroidAppShortcuts",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.nwmissouri.studentplanner.widgets",
          "groupIdentifier": "group.com.nwmissouri.studentplanner",
          "widgets": [
            {
              "name": "DueToday",
              "displayName": "Due Today",
              "description": "An interactive agenda with deadlines, priority, completion and quick capture. Browse every item without opening the app.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline",
                  "systemLarge",
                  "systemExtraLarge"
                ],
                "configuration": {
                  "title": "Due Today",
                  "description": "Choose what this widget counts and how it looks.",
                  "parameters": {
                    "horizon": {
                      "title": "Look ahead",
                      "type": "enum",
                      "default": "today",
                      "values": [
                        {
                          "name": "Today",
                          "value": "today"
                        },
                        {
                          "name": "Next 3 days",
                          "value": "next3"
                        },
                        {
                          "name": "This week",
                          "value": "week"
                        }
                      ]
                    },
                    "include": {
                      "title": "Include",
                      "type": "enum",
                      "default": "all",
                      "values": [
                        {
                          "name": "Tasks and reminders",
                          "value": "all"
                        },
                        {
                          "name": "Tasks only",
                          "value": "tasks"
                        },
                        {
                          "name": "Reminders only",
                          "value": "reminders"
                        }
                      ]
                    },
                    "onlyHigh": {
                      "title": "High priority only",
                      "type": "boolean",
                      "default": false
                    },
                    "density": {
                      "title": "Density",
                      "type": "enum",
                      "default": "comfortable",
                      "values": [
                        {
                          "name": "Comfortable",
                          "value": "comfortable"
                        },
                        {
                          "name": "Compact",
                          "value": "compact"
                        }
                      ]
                    },
                    "accent": {
                      "title": "Accent",
                      "type": "enum",
                      "default": "green",
                      "values": [
                        {
                          "name": "Northwest Green",
                          "value": "green"
                        },
                        {
                          "name": "Blue",
                          "value": "blue"
                        },
                        {
                          "name": "Plum",
                          "value": "plum"
                        },
                        {
                          "name": "Amber",
                          "value": "amber"
                        }
                      ]
                    },
                    "showTitles": {
                      "title": "Show titles (when allowed in app)",
                      "type": "boolean",
                      "default": true
                    },
                    "includeOverdue": {
                      "title": "Include overdue",
                      "type": "boolean",
                      "default": true
                    },
                    "includeUndated": {
                      "title": "Include tasks without a date",
                      "type": "boolean",
                      "default": false
                    },
                    "sort": {
                      "title": "Order by",
                      "type": "enum",
                      "default": "deadline",
                      "values": [
                        {
                          "name": "Deadline",
                          "value": "deadline"
                        },
                        {
                          "name": "Priority first",
                          "value": "priority"
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "name": "UpNext",
              "displayName": "Up Next",
              "description": "Your next deadline, a live countdown, and a checkbox that saves even when the app is closed.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline",
                  "systemLarge",
                  "systemExtraLarge"
                ],
                "configuration": {
                  "title": "Up Next",
                  "description": "Choose what counts as next.",
                  "parameters": {
                    "include": {
                      "title": "Include",
                      "type": "enum",
                      "default": "all",
                      "values": [
                        {
                          "name": "Tasks and reminders",
                          "value": "all"
                        },
                        {
                          "name": "Tasks only",
                          "value": "tasks"
                        },
                        {
                          "name": "Reminders only",
                          "value": "reminders"
                        }
                      ]
                    },
                    "countdown": {
                      "title": "Show a countdown",
                      "type": "boolean",
                      "default": true
                    },
                    "accent": {
                      "title": "Accent",
                      "type": "enum",
                      "default": "green",
                      "values": [
                        {
                          "name": "Northwest Green",
                          "value": "green"
                        },
                        {
                          "name": "Blue",
                          "value": "blue"
                        },
                        {
                          "name": "Plum",
                          "value": "plum"
                        },
                        {
                          "name": "Amber",
                          "value": "amber"
                        }
                      ]
                    },
                    "showTitles": {
                      "title": "Show titles (when allowed in app)",
                      "type": "boolean",
                      "default": true
                    },
                    "includeOverdue": {
                      "title": "Include overdue",
                      "type": "boolean",
                      "default": true
                    },
                    "includeUndated": {
                      "title": "Include tasks without a date",
                      "type": "boolean",
                      "default": false
                    },
                    "sort": {
                      "title": "Order by",
                      "type": "enum",
                      "default": "deadline",
                      "values": [
                        {
                          "name": "Deadline",
                          "value": "deadline"
                        },
                        {
                          "name": "Priority first",
                          "value": "priority"
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "name": "ThisWeek",
              "displayName": "This Week",
              "description": "Explore seven days of work. Tap a day to see its agenda; red marks high priority items.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge",
                  "systemExtraLarge"
                ],
                "configuration": {
                  "title": "This Week",
                  "description": "Choose what the bars count.",
                  "parameters": {
                    "include": {
                      "title": "Include",
                      "type": "enum",
                      "default": "all",
                      "values": [
                        {
                          "name": "Tasks and reminders",
                          "value": "all"
                        },
                        {
                          "name": "Tasks only",
                          "value": "tasks"
                        },
                        {
                          "name": "Reminders only",
                          "value": "reminders"
                        }
                      ]
                    },
                    "hideDone": {
                      "title": "Hide finished work",
                      "type": "boolean",
                      "default": true
                    },
                    "accent": {
                      "title": "Accent",
                      "type": "enum",
                      "default": "green",
                      "values": [
                        {
                          "name": "Northwest Green",
                          "value": "green"
                        },
                        {
                          "name": "Blue",
                          "value": "blue"
                        },
                        {
                          "name": "Plum",
                          "value": "plum"
                        },
                        {
                          "name": "Amber",
                          "value": "amber"
                        }
                      ]
                    },
                    "showTitles": {
                      "title": "Show titles (when allowed in app)",
                      "type": "boolean",
                      "default": true
                    }
                  }
                }
              }
            },
            {
              "name": "Progress",
              "displayName": "Today\u2019s Progress",
              "description": "Completion for items due today, overdue work and quick capture on your Home Screen or Lock Screen.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      "./plugins/withNativePlannerWidgets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f06f4ed-3363-42be-b39c-5779a200dc93"
      }
    }
  }
}
