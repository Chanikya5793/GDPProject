<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/planner_progress_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/planner_widget_background"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/planner_widget_progress"
    android:textColor="@color/planner_widget_accent"
    android:textSize="13sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/planner_progress_count"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:textColor="@color/planner_widget_text"
    android:textSize="26sp"
    android:textStyle="bold" />

  <ProgressBar
    android:id="@+id/planner_progress_bar"
    style="@android:style/Widget.ProgressBar.Horizontal"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:layout_marginTop="6dp"
    android:progressTint="@color/planner_widget_accent"
    android:progressBackgroundTint="@color/planner_widget_faint" />

  <TextView
    android:id="@+id/planner_progress_detail"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:maxLines="2"
    android:textColor="@color/planner_widget_muted"
    android:textSize="11sp" />
</LinearLayout>
