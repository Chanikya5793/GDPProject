<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/planner_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/planner_widget_background"
  android:orientation="vertical"
  android:paddingStart="14dp"
  android:paddingTop="10dp"
  android:paddingEnd="8dp"
  android:paddingBottom="8dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/planner_header"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/planner_widget_due_today"
        android:textColor="@color/planner_widget_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/planner_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/planner_widget_muted"
        android:textSize="12sp" />
    </LinearLayout>

    <ImageView
      android:id="@+id/planner_add"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:padding="8dp"
      android:contentDescription="@string/planner_widget_add"
      android:src="@drawable/planner_widget_add" />
  </LinearLayout>

  <TextView
    android:id="@+id/planner_notice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:maxLines="2"
    android:textColor="@color/planner_widget_danger"
    android:textSize="11sp"
    android:visibility="gone" />

  <TextView
    android:id="@+id/planner_empty"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:textColor="@color/planner_widget_muted"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/planner_rows"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="4dp"
    android:orientation="vertical" />

  <LinearLayout
    android:id="@+id/planner_pager"
    android:layout_width="match_parent"
    android:layout_height="28dp"
    android:gravity="center_vertical|end"
    android:orientation="horizontal"
    android:visibility="gone">

    <TextView
      android:id="@+id/planner_page_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="4dp"
      android:textColor="@color/planner_widget_muted"
      android:textSize="11sp" />

    <ImageView
      android:id="@+id/planner_prev"
      android:layout_width="32dp"
      android:layout_height="28dp"
      android:padding="4dp"
      android:contentDescription="@string/planner_widget_previous"
      android:src="@drawable/planner_widget_prev" />

    <ImageView
      android:id="@+id/planner_next"
      android:layout_width="32dp"
      android:layout_height="28dp"
      android:padding="4dp"
      android:contentDescription="@string/planner_widget_next"
      android:src="@drawable/planner_widget_next" />
  </LinearLayout>
</LinearLayout>
